# Copy this file to .env and fill in real values before running.
# ---------------------------------------------------------------
# Database credentials (use the ones you were given, or the defaults
# below to run entirely locally via docker-compose).
POSTGRES_USER=ocr_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ocr_gov
# Only needed if running the backend outside docker-compose (compose
# builds this from the POSTGRES_* vars above automatically):
DATABASE_URL=postgresql://ocr_user:change-me@localhost:5432/ocr_gov
# Host port for the Compose Postgres container. Change it (e.g. 5433) if
# something else on your machine already uses 5432, such as Postgres.app.
POSTGRES_HOST_PORT=5432

# --- Auth / encryption (generate your own — do not reuse these) ---
# Any long random string, used to sign JWT login tokens:
SECRET_KEY=replace-with-a-long-random-string
# Fernet key (AES-based) used to encrypt uploaded documents at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OCR / ML ---
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng
# English uses BERT; Indic/mixed-language documents use MuRIL by default.
ML_MODEL_NAME=bert-base-uncased
ML_MODEL_NAME_INDIC=google/muril-base-cased
# Persist downloaded Hugging Face weights between container restarts.
HF_HOME=/data/huggingface
UPLOAD_DIR=./data/uploads

# --- Optional: GPT correction suggestions (off by default) ---
# When enabled, flagged words and their OCR line (digits masked as '#') are
# sent to OpenAI for better suggestions. Leave off for real citizen documents
# unless sending that text to OpenAI is permitted.
LLM_SUGGESTIONS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Lower = faster. Valid values depend on the model; leave empty for models
# without reasoning (e.g. gpt-4.1-mini).
OPENAI_REASONING_EFFORT=minimal

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
